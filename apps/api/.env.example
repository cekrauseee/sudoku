# Copied to .env by `pnpm dev` (or `pnpm --filter @repo/api setup`).
# Missing keys are added to an existing .env without changing other values.

PORT=3000
# Public URL of this API. OAuth callbacks and avatar URLs are built from it.
API_URL=http://localhost:3000
# Origin of the web app allowed to call the API with credentials.
WEB_URL=http://localhost:5173
# Secret used to sign sessions. Generated automatically when empty.
AUTH_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Matches the `postgres` service in compose.yaml.
DATABASE_URL=postgres://sudoku:sudoku@localhost:5440/sudoku

# Matches the `storage` service (RustFS, S3-compatible) in compose.yaml.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=sudoku
S3_ACCESS_KEY_ID=sudoku
S3_SECRET_ACCESS_KEY=sudoku-secret
