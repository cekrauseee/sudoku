{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "lint": "eslint --max-warnings 0 .",
    "check-types": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "node scripts/setup.ts && drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@typescript/native": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
