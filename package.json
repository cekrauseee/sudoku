{
  "name": "sudoku",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && turbo run lint check-types test",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26"
  }
}
